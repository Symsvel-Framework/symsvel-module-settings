{
    "name": "symsvel-framework/module-settings",
    "description": "SymSvel module Settings",
    "type": "symfony-bundle",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-sodium": "*",
        "doctrine/doctrine-bundle": "^2.15 || ^3.0",
        "doctrine/orm": "^3.0",
        "symfony/framework-bundle": "^8.1",
        "symsvel-framework/module-acls": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "SymSvel\\Module\\Settings\\": "back/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SymSvel\\Module\\Settings\\Tests\\": "back/tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "symfony/cache": "^8.1"
    },
    "scripts": {
        "test": "phpunit -c back/phpunit.xml.dist --display-skipped",
        "qa": [
            "@test"
        ]
    },
    "extra": {
        "symsvel-module": {
            "manifest": "module.json"
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Symsvel-Framework/symsvel-module-acls.git"
        }
    ]
}
